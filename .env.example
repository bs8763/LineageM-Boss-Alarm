# Set these in Render environment; never commit actual keys.
CLAN_TOKEN=replace-with-random-at-least-24-characters
ADMIN_TOKEN=replace-with-a-different-random-admin-key
# External PostgreSQL with durable storage; use provider-required TLS settings.
# Do not use sslmode=no-verify or rejectUnauthorized=false.
DATABASE_URL=postgresql://user:password@host/database?sslmode=verify-full
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_GUILD_ID=
DISCORD_ADMIN_IDS=
# Enable once after validating the web/DB deployment, then turn off.
REGISTER_DISCORD_COMMANDS=false
PORT=3000
